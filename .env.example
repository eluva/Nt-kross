# Локально: скопируйте в .env и заполните (файл .env не попадает в git).
# На Vercel: те же переменные в Project → Settings → Environment Variables.

# ===== BILLZ =====
# Ключ BILLZ (Настройки → Интеграции → API)
BILLZ_SECRET_TOKEN=
# Магазин BILLZ; пусто = первый магазин компании
BILLZ_SHOP_ID=
# 1 = оплаченный онлайн заказ проводится продажей в BILLZ (товары + клиент + оплата).
# Ещё не проверено на живом BILLZ — держим 0 до тестового заказа.
BILLZ_CREATE_ORDERS=0
# Способ оплаты BILLZ (id), которым записывать Payme/Click; пусто = «Карта»
BILLZ_PAYTYPE_PAYME=
BILLZ_PAYTYPE_CLICK=

# ===== Telegram =====
# Бот присылает менеджеру наличные заказы и уведомления об оплате
TELEGRAM_BOT_TOKEN=
TELEGRAM_MANAGER_CHAT_ID=

# ===== Онлайн-оплата =====
# Пока ключей нет, в приложении доступна только оплата наличными.
# Адрес сайта — сюда клиент возвращается после оплаты
APP_URL=https://nt-kross.vercel.app
# Payme Business: ID кассы и ключ (в кабинете). Endpoint для Payme: https://<сайт>/api/payme
PAYME_MERCHANT_ID=
PAYME_KEY=
# 1 = тестовая касса (checkout.test.paycom.uz)
PAYME_TEST=0
# Click Merchant: Prepare и Complete URL — https://<сайт>/api/click
CLICK_SERVICE_ID=
CLICK_MERCHANT_ID=
CLICK_SECRET_KEY=
# Сколько минут после оформления можно начать оплату
ORDER_PAY_MIN=30

# ===== Хранилище заказов и снимок каталога (обязательно для онлайн-оплаты на Vercel) =====
# Vercel → Storage → Upstash Redis → Connect: переменные добавятся сами.
# Со снимком холодный старт отдаёт каталог за секунду вместо минуты полного прохода по BILLZ.
KV_REST_API_URL=
KV_REST_API_TOKEN=

# ===== Только для локального server.js =====
PORT=3000
CATALOG_REFRESH_MIN=3
CATALOG_FULL_MIN=60
