# Локально: скопируйте в .env и заполните (файл .env не попадает в git).
# На Vercel: те же переменные в Project → Settings → Environment Variables.

# ===== BILLZ =====
# Ключ BILLZ (Настройки → Интеграции → API)
BILLZ_SECRET_TOKEN=
# Магазин BILLZ; пусто = первый магазин компании
BILLZ_SHOP_ID=
# 1 = заказанные на сайте пары откладываются в BILLZ (отложенная продажа) — на кассе их уже не продать.
# Отмена заказа кнопкой в боте сотрудников снимает отложку. Пусто/0 — пары снимаются только с сайта
BILLZ_RESERVE=0
# Касса для отложенных продаж; пусто = первая касса магазина
BILLZ_CASHBOX_ID=

# ===== Бот мини-приложения =====
# Через него открывается приложение; он же присылает заказы менеджеру
TELEGRAM_BOT_TOKEN=
TELEGRAM_MANAGER_CHAT_ID=

# ===== Бот для сотрудников =====
# Отдельный бот (создайте в @BotFather). Сотрудник пишет ему /start → администратору приходит заявка;
# пущенные сотрудники получают заказы, с правом «наличие» — проверяют размеры по названию модели. /staff — список и бан.
STAFF_BOT_TOKEN=
# Telegram ID администраторов через запятую (свой ID бот пришлёт в ответ на /id)
STAFF_ADMIN_IDS=
# Любая длинная строка из латиницы, цифр, _ и -. После деплоя один раз откройте
# https://<сайт>/api/staffbot?setup=<эта строка> — бот привяжется к сайту
STAFF_WEBHOOK_SECRET=
# Только локально: 1 = server.js сам забирает сообщения бота (нужен отдельный тестовый бот без вебхука)
STAFF_BOT_POLL=0

# ===== Админка (/admin.html) =====
# Сотрудники правят витрину вручную: названия, цены, скидки, фото, размеры, свои товары, магазин, доставку.
# Из Telegram: бот сотрудников → /admin (администраторам — всегда, сотрудникам — кнопка «✏️ Админка» в /staff).
# С компьютера: https://<сайт>/admin.html и этот пароль. Пусто — вход по паролю выключен.
ADMIN_PASSWORD=
# Адрес сайта для кнопки /admin. На Vercel не нужен — берётся сам
APP_URL=
# Загрузка фото с телефона: Vercel → Storage → Blob → Connect, переменная добавится сама.
# Без неё фото можно добавлять ссылкой. Локально фото сохраняются в .cache/uploads
BLOB_READ_WRITE_TOKEN=

# ===== Хранилище (обязательно на Vercel для бота сотрудников и админки) =====
# Vercel → Storage → Upstash Redis → Connect: переменные добавятся сами.
# Хранит список сотрудников, правки админки и снимок каталога (холодный старт отдаёт каталог сразу).
KV_REST_API_URL=
KV_REST_API_TOKEN=

# ===== Только для локального server.js =====
PORT=3000
# каталог старше стольких секунд — сначала спросить изменения у BILLZ
CATALOG_FRESH_SEC=8
CATALOG_FULL_MIN=60
