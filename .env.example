# Локально: скопируйте в .env и заполните (файл .env не попадает в git).
# На Vercel: те же переменные в Project → Settings → Environment Variables.

# Ключ BILLZ (Настройки → Интеграции → API)
BILLZ_SECRET_TOKEN=

# Магазин BILLZ; пусто = первый магазин компании
BILLZ_SHOP_ID=

# 1 = создавать черновик заказа в BILLZ (клиент + товары, без оплаты). Ещё не проверено — держим 0.
BILLZ_CREATE_ORDERS=0

# Бот, который присылает заказы менеджеру, и чат менеджера (id пользователя или группы)
TELEGRAM_BOT_TOKEN=
TELEGRAM_MANAGER_CHAT_ID=

# только для локального server.js
PORT=3000
# как часто подтягивать изменения и перечитывать весь каталог, минуты
CATALOG_REFRESH_MIN=3
CATALOG_FULL_MIN=60
